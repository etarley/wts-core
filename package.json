{
  "name": "wts-core",
  "version": "1.0.3",
  "description": "A modern, Hono-like abstraction for WhatsApp automation supporting Baileys and Cloud API.",
  "author": "WhiskeySockets",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whiskeysockets/wts-core.git"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "cloud-api",
    "bot",
    "automation",
    "typescript",
    "wts-core",
    "hono",
    "jsx"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "eslint src/**/*.ts",
    "prepublishOnly": "bun run build",
    "knip": "knip"
  },
  "type": "module",
  "sideEffects": false,
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@hapi/boom": "^10.0.1",
    "@libsql/client": "^0.15.15",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.3",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^24.10.1",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/sharp": "^0.32.0",
    "better-sqlite3": "^12.4.6",
    "eslint": "^9.39.1",
    "fluent-ffmpeg": "^2.1.3",
    "globals": "^16.5.0",
    "knip": "^5.70.1",
    "patch-package": "^8.0.1",
    "sharp": "^0.34.5",
    "tsup": "^8.5.1",
    "typescript-eslint": "^8.47.0"
  },
  "peerDependencies": {
    "fluent-ffmpeg": "^2.1.3",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3"
  },
  "peerDependenciesMeta": {
    "fluent-ffmpeg": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc.9",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.1.12"
  }
}
